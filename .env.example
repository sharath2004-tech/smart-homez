# Frontend Environment Variables
# Copy this file to .env.local for local development
# or .env.production for production build

# Backend API URL
VITE_API_URL=http://localhost:5000/api

# App Configuration
VITE_APP_NAME=Pure App Weave
VITE_APP_VERSION=1.0.0

# Feature Flags (optional)
VITE_ENABLE_ANALYTICS=false
VITE_ENABLE_DEBUG=true

# Firebase Configuration (REMOVED — OTP now uses Twilio, see below)

# ── Backend environment variables (add to backend/.env) ──────────────────────

# Twilio SMS OTP — https://console.twilio.com
# 1. Create a Verify Service in Twilio Console and copy the SID
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=your_twilio_auth_token
TWILIO_VERIFY_SID=VAxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
