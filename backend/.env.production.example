# Production Environment Configuration
# Copy this file to .env.production and update with your production values

# MongoDB Atlas Connection String
MONGODB_URI=mongodb+srv://username:password@cluster.mongodb.net/pure-app-weave-prod?retryWrites=true&w=majority&appName=Cluster0

# Server Configuration
PORT=5000
NODE_ENV=production

# JWT Secret (IMPORTANT: Use a strong, unique secret in production)
JWT_SECRET=CHANGE_THIS_TO_A_STRONG_RANDOM_SECRET_IN_PRODUCTION_MIN_32_CHARS

# Client URLs (for CORS) - Add your production frontend URLs
CLIENT_URL=https://your-frontend-domain.com
ALLOWED_ORIGINS=https://your-frontend-domain.com,https://www.your-frontend-domain.com

# Email Configuration (Optional - if using nodemailer)
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=your-email@gmail.com
EMAIL_PASSWORD=your-app-specific-password
EMAIL_FROM=no-reply@your-domain.com

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# Session Configuration
SESSION_SECRET=CHANGE_THIS_TO_A_STRONG_RANDOM_SESSION_SECRET

# API Keys (if needed)
# GOOGLE_MAPS_API_KEY=your-google-maps-api-key
# STRIPE_SECRET_KEY=your-stripe-secret-key
