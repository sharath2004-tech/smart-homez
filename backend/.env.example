# MongoDB Atlas Connection String
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/smart-homez?retryWrites=true&w=majority&appName=Cluster0

# Server Configuration
PORT=5000
NODE_ENV=development

# JWT Secret
JWT_SECRET=your_jwt_secret_key_here_change_in_production

# Allowed Origins (for CORS) - comma-separated list
# Supports wildcards: https://smart-homez-*.vercel.app
# For production, add your frontend domain(s)
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:8080,http://localhost:8081,http://localhost:8082

# Firebase Admin SDK (for phone OTP verification)
# Download from Firebase Console → Project Settings → Service Accounts → Generate new private key
FIREBASE_PROJECT_ID=your-firebase-project-id
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxxxx@your-project.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nYOUR_PRIVATE_KEY_HERE\n-----END PRIVATE KEY-----\n"

# ============================================
# MSG91 OTP Widget (No DLT required)
# ============================================
# Used for client-side OTP via the MSG91 Widget (exposeMethods mode).
# Get from MSG91 Dashboard → OTP Widget → Widget Settings.
# The backend uses this to verify the access token returned by the widget.
MSG91_WIDGET_ID=your_msg91_widget_id_here

# ============================================
# MSG91 SMS OTP Configuration (Recommended)
# ============================================
# Sign up at https://msg91.com → Dashboard → API Keys
# Required for: WhatsApp notifications, server-side token verification
MSG91_AUTH_KEY=your_msg91_auth_key_here
MSG91_SENDER_ID=HLTHYZ
MSG91_OTP_TEMPLATE_ID=your_dlt_approved_template_id
MSG91_OTP_EXPIRY=600

# ============================================
# Twilio SMS Configuration (Optional Fallback)
# ============================================
# Only used if TWILIO_ENABLED=true and MSG91 fails
# Get credentials from https://console.twilio.com
TWILIO_ENABLED=false
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=your_twilio_auth_token_here
TWILIO_VERIFY_SID=VAxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_PHONE_NUMBER=+1234567890

# ============================================
# Twilio WhatsApp Business Configuration
# ============================================
# Use a WhatsApp-enabled Twilio sender such as whatsapp:+14155238886 in sandbox,
# or your approved WhatsApp Business sender in production.
TWILIO_WHATSAPP_NUMBER=whatsapp:+14155238886

# Preferred OTP delivery channel: sms | whatsapp | msg91_whatsapp
OTP_DELIVERY_CHANNEL=sms

# ============================================
# MSG91 WhatsApp Business Configuration
# ============================================
# Set up at MSG91 Dashboard → WhatsApp → Configure
# 1. Register your WhatsApp Business number on MSG91
# 2. Create & get approval for message templates
# 3. Copy integrated number and template namespace below
MSG91_WHATSAPP_INTEGRATED_NUMBER=919XXXXXXXXX
MSG91_WHATSAPP_TEMPLATE_NAMESPACE=your_template_namespace

# MSG91 WhatsApp Template Names (must match approved templates in MSG91 dashboard)
# Override defaults by setting these env vars:
MSG91_WA_TPL_OTP=otp_verification
MSG91_WA_TPL_BOOKING_CONFIRMED=booking_confirmed
MSG91_WA_TPL_BOOKING_CANCELLED=booking_cancelled
MSG91_WA_TPL_BOOKING_RESCHEDULED=booking_rescheduled
MSG91_WA_TPL_WORKER_ASSIGNED=worker_assigned
MSG91_WA_TPL_WORKER_REASSIGNMENT=worker_reassignment
MSG91_WA_TPL_WORKER_ENROUTE=worker_enroute
MSG91_WA_TPL_SCHEDULE_CHANGE=schedule_change
MSG91_WA_TPL_DELAY=delay_notification
MSG91_WA_TPL_REFUND=refund_processed
MSG91_WA_TPL_PAYMENT=payment_received
MSG91_WA_TPL_SUB_ACTIVATED=subscription_activated
MSG91_WA_TPL_SUB_RENEWAL=subscription_renewal
MSG91_WA_TPL_SUB_PAUSED=subscription_paused
MSG91_WA_TPL_SOS=sos_alert
MSG91_WA_TPL_WELCOME=welcome_message
MSG91_WA_TPL_GENERIC=generic_notification

# ============================================
# DLT Compliance (India Only - REQUIRED for Production SMS)
# ============================================
# India's TRAI regulation requires all commercial SMS to be registered
# Steps to complete DLT registration:
# 1. Visit https://www.vilpower.in/ (TRAI DLT Portal)
# 2. Register your business as Principal Entity
# 3. Create SMS OTP template (example: "Your OTP is {#var#}. Valid for 10 minutes. - HLTHYZ")
# 4. Wait for template approval (1-2 business days)
# 5. Copy approved template ID to MSG91_OTP_TEMPLATE_ID above
# 6. Link template to your MSG91 account
# Note: SMS will be blocked in India without DLT approval

# ============================================
# Google OAuth Configuration (Customer Login)
# ============================================
# Required for "Continue with Google" on customer signup
# Get credentials from: https://console.cloud.google.com
# Steps:
# 1. Create/select a project
# 2. Go to APIs & Services → Credentials
# 3. Create OAuth 2.0 Client ID (Web application)
# 4. Add authorized origins: http://localhost:8080, your-domain.com
# 5. Copy Client ID and Client Secret
GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=GOCSPX-your_google_client_secret
