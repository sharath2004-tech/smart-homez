import { Minus, Plus, Save, X } from "lucide-react";
import { useState } from "react";

// eslint-disable-next-line @typescript-eslint/no-explicit-any
type ServiceData = Record<string, any>;

interface ServiceParametersEditorProps {
  serviceData: ServiceData;
  onChange: (data: ServiceData) => void;
  onSave: () => void;
  onCancel: () => void;
}

const SERVICE_TYPES = [
  { value: 'instant_hourly', label: 'On-Demand Hourly Service' },
  { value: 'monthly_subscription', label: 'Monthly Subscription' },
  { value: 'deep_cleaning_full_house', label: 'Full House Deep Cleaning' },
  { value: 'deep_cleaning_room', label: 'Room-Specific Deep Cleaning' },
  { value: 'deep_cleaning_kitchen', label: 'Kitchen Deep Cleaning' },
  { value: 'deep_cleaning_bathroom', label: 'Bathroom Deep Cleaning' },
  { value: 'fixed_washroom_basic', label: 'Basic Washroom Cleaning' },
  { value: 'fixed_washroom_deep', label: 'Deep Washroom Cleaning' },
  { value: 'fixed_fan_cleaning', label: 'Fan Cleaning' },
  { value: 'fixed_window_cleaning', label: 'Window Cleaning' },
  { value: 'fixed_sofa_cleaning', label: 'Sofa Cleaning' },
  { value: 'fixed_carpet_cleaning', label: 'Carpet Cleaning' },
  { value: 'fixed_balcony_cleaning', label: 'Balcony Cleaning' },
  { value: 'other', label: 'Other/Custom' }
];

const ServiceParametersEditor = ({ serviceData, onChange, onSave, onCancel }: ServiceParametersEditorProps) => {
  const [activeTab, setActiveTab] = useState<'basic' | 'pricing' | 'subscription' | 'addons' | 'advanced'>('basic');

  // eslint-disable-next-line @typescript-eslint/no-explicit-any
  const updateField = (path: string, value: any) => {
    const keys = path.split('.');
    const newData = { ...serviceData };
    // eslint-disable-next-line @typescript-eslint/no-explicit-any
    let current: any = newData;
    
    for (let i = 0; i < keys.length - 1; i++) {
      if (!current[keys[i]]) current[keys[i]] = {};
      current = current[keys[i]];
    }
    
    current[keys[keys.length - 1]] = value;
    onChange(newData);
  };

  // eslint-disable-next-line @typescript-eslint/no-explicit-any
  const addArrayItem = (path: string, defaultItem: any) => {
    const keys = path.split('.');
    const newData = { ...serviceData };
    // eslint-disable-next-line @typescript-eslint/no-explicit-any
    let current: any = newData;
    
    for (const key of keys.slice(0, -1)) {
      if (!current[key]) current[key] = {};
      current = current[key];
    }
    
    const lastKey = keys[keys.length - 1];
    if (!current[lastKey]) current[lastKey] = [];
    current[lastKey] = [...current[lastKey], defaultItem];
    
    onChange(newData);
  };

  const removeArrayItem = (path: string, index: number) => {
    const keys = path.split('.');
    const newData = { ...serviceData };
    // eslint-disable-next-line @typescript-eslint/no-explicit-any
    let current: any = newData;
    
    for (const key of keys.slice(0, -1)) {
      current = current[key];
    }
    
    const lastKey = keys[keys.length - 1];
    // eslint-disable-next-line @typescript-eslint/no-explicit-any
    current[lastKey] = current[lastKey].filter((_: any, i: number) => i !== index);
    
    onChange(newData);
  };

  // eslint-disable-next-line @typescript-eslint/no-explicit-any
  const updateArrayItem = (path: string, index: number, field: string, value: any) => {
    const keys = path.split('.');
    const newData = { ...serviceData };
    // eslint-disable-next-line @typescript-eslint/no-explicit-any
    let current: any = newData;
    
    for (const key of keys.slice(0, -1)) {
      if (!current[key]) current[key] = {};
      current = current[key];
    }
    
    const lastKey = keys[keys.length - 1];
    if (!current[lastKey]) current[lastKey] = [];
    current[lastKey][index] = { ...current[lastKey][index], [field]: value };
    
    onChange(newData);
  };

  return (
    <div className="fixed inset-0 bg-black/50 flex items-center justify-center z-50 p-4 overflow-y-auto">
      <div className="bg-card rounded-2xl shadow-2xl max-w-6xl w-full max-h-[90vh] overflow-hidden flex flex-col">
        {/* Header */}
        <div className="p-6 border-b border-border flex items-center justify-between bg-gradient-to-r from-primary/10 to-primary/5">
          <div>
            <h2 className="text-2xl font-bold text-foreground">Service Parameters Editor</h2>
            <p className="text-sm text-muted-foreground">Configure all service options and parameters</p>
          </div>
          <button
            onClick={onCancel}
            className="p-2 hover:bg-muted rounded-lg transition-colors"
          >
            <X className="w-6 h-6" />
          </button>
        </div>

        {/* Tabs */}
        <div className="flex gap-2 p-4 border-b border-border overflow-x-auto">
          {[
            { id: 'basic', label: 'Basic Info', icon: '📋' },
            { id: 'pricing', label: 'Pricing & Size', icon: '💰' },
            { id: 'subscription', label: 'Subscription', icon: '📅' },
            { id: 'addons', label: 'Add-ons & Extras', icon: '➕' },
            { id: 'advanced', label: 'Advanced', icon: '⚙️' }
          ].map((tab) => (
            <button
              key={tab.id}
              onClick={() => setActiveTab(tab.id as 'basic' | 'pricing' | 'subscription' | 'addons' | 'advanced')}
              className={`px-4 py-2 rounded-lg font-medium whitespace-nowrap transition-all ${
                activeTab === tab.id
                  ? 'bg-primary text-primary-foreground shadow-md'
                  : 'bg-muted text-muted-foreground hover:bg-muted/80'
              }`}
            >
              {tab.icon} {tab.label}
            </button>
          ))}
        </div>

        {/* Content */}
        <div className="flex-1 overflow-y-auto p-6">
          {/* BASIC INFO TAB */}
          {activeTab === 'basic' && (
            <div className="space-y-6">
              <div>
                <label className="block text-sm font-medium mb-2">Service Type</label>
                <select
                  value={serviceData.serviceType || 'other'}
                  onChange={(e) => updateField('serviceType', e.target.value)}
                  className="w-full p-3 rounded-lg border border-border bg-background"
                >
                  {SERVICE_TYPES.map((type) => (
                    <option key={type.value} value={type.value}>
                      {type.label}
                    </option>
                  ))}
                </select>
                <p className="text-xs text-muted-foreground mt-1">
                  Select the type of service to enable specific parameters
                </p>
              </div>

              <div>
                <label className="block text-sm font-medium mb-2">Service Name</label>
                <input
                  type="text"
                  value={serviceData.name || ''}
                  onChange={(e) => updateField('name', e.target.value)}
                  className="w-full p-3 rounded-lg border border-border bg-background"
                  placeholder="e.g., Deep Kitchen Cleaning"
                />
              </div>

              <div>
                <label className="block text-sm font-medium mb-2">Description</label>
                <textarea
                  value={serviceData.description || ''}
                  onChange={(e) => updateField('description', e.target.value)}
                  rows={4}
                  className="w-full p-3 rounded-lg border border-border bg-background"
                  placeholder="Describe the service in detail..."
                />
              </div>

              <div className="grid grid-cols-1 md:grid-cols-3 gap-4">
                <div>
                  <label className="block text-sm font-medium mb-2">Base Price (₹)</label>
                  <input
                    type="number"
                    value={serviceData.price || 0}
                    onChange={(e) => updateField('price', parseFloat(e.target.value))}
                    className="w-full p-3 rounded-lg border border-border bg-background"
                  />
                </div>

                <div>
                  <label className="block text-sm font-medium mb-2">Duration (minutes)</label>
                  <input
                    type="number"
                    value={serviceData.duration || 60}
                    onChange={(e) => updateField('duration', parseInt(e.target.value))}
                    className="w-full p-3 rounded-lg border border-border bg-background"
                  />
                </div>

                <div>
                  <label className="block text-sm font-medium mb-2">Category</label>
                  <select
                    value={serviceData.category || 'cleaning'}
                    onChange={(e) => updateField('category', e.target.value)}
                    className="w-full p-3 rounded-lg border border-border bg-background"
                  >
                    <option value="cleaning">Cleaning</option>
                    <option value="maintenance">Maintenance</option>
                    <option value="health">Health</option>
                    <option value="consultation">Consultation</option>
                    <option value="therapy">Therapy</option>
                    <option value="other">Other</option>
                  </select>
                </div>
              </div>

              <div>
                <label className="flex items-center gap-2">
                  <input
                    type="checkbox"
                    checked={serviceData.isActive !== false}
                    onChange={(e) => updateField('isActive', e.target.checked)}
                    className="w-4 h-4"
                  />
                  <span className="text-sm font-medium">Service is Active</span>
                </label>
              </div>
            </div>
          )}

          {/* PRICING & SIZE TAB */}
          {activeTab === 'pricing' && (
            <div className="space-y-6">
              {/* Size-Based Parameters */}
              <div className="card-elevated p-4">
                <div className="flex items-center justify-between mb-4">
                  <h3 className="text-lg font-bold">Size-Based Pricing</h3>
                  <label className="flex items-center gap-2">
                    <input
                      type="checkbox"
                      checked={serviceData.sizeParameters?.enabled || false}
                      onChange={(e) => updateField('sizeParameters.enabled', e.target.checked)}
                      className="w-4 h-4"
                    />
                    <span className="text-sm">Enable</span>
                  </label>
                </div>

                {serviceData.sizeParameters?.enabled && (
                  <div className="space-y-4">
                    <div>
                      <label className="block text-sm font-medium mb-2">Size Type</label>
                      <select
                        value={serviceData.sizeParameters?.sizeType || 'quantity'}
                        onChange={(e) => updateField('sizeParameters.sizeType', e.target.value)}
                        className="w-full p-2 rounded-lg border border-border bg-background"
                      >
                        <option value="house_size">House Size (BHK)</option>
                        <option value="room_size">Room Size</option>
                        <option value="area_sqft">Area (Sq Ft)</option>
                        <option value="quantity">Quantity</option>
                      </select>
                    </div>

                    <div>
                      <div className="flex items-center justify-between mb-2">
                        <label className="text-sm font-medium">Size Options</label>
                        <button
                          onClick={() => addArrayItem('sizeParameters.options', {
                            value: '',
                            label: '',
                            price: 0,
                            duration: 60,
                            workersRequired: 1
                          })}
                          className="text-sm text-primary flex items-center gap-1"
                        >
                          <Plus className="w-4 h-4" /> Add Option
                        </button>
                      </div>
                    {/* eslint-disable-next-line @typescript-eslint/no-explicit-any */}
                      {serviceData.sizeParameters?.options?.map((opt: any, idx: number) => (
                        <div key={idx} className="grid grid-cols-5 gap-2 mb-2">
                          <input
                            type="text"
                            value={opt.value || ''}
                            onChange={(e) => updateArrayItem('sizeParameters.options', idx, 'value', e.target.value)}
                            placeholder="Value (e.g., 1BHK)"
                            className="p-2 rounded border border-border bg-background"
                          />
                          <input
                            type="text"
                            value={opt.label || ''}
                            onChange={(e) => updateArrayItem('sizeParameters.options', idx, 'label', e.target.value)}
                            placeholder="Label"
                            className="p-2 rounded border border-border bg-background"
                          />
                          <input
                            type="number"
                            value={opt.price || 0}
                            onChange={(e) => updateArrayItem('sizeParameters.options', idx, 'price', parseFloat(e.target.value))}
                            placeholder="Price"
                            className="p-2 rounded border border-border bg-background"
                          />
                          <input
                            type="number"
                            value={opt.duration || 60}
                            onChange={(e) => updateArrayItem('sizeParameters.options', idx, 'duration', parseInt(e.target.value))}
                            placeholder="Duration (min)"
                            className="p-2 rounded border border-border bg-background"
                          />
                          <button
                            onClick={() => removeArrayItem('sizeParameters.options', idx)}
                            className="p-2 bg-red-500/10 text-red-500 rounded hover:bg-red-500/20"
                          >
                            <Minus className="w-4 h-4" />
                          </button>
                        </div>
                      ))}
                    </div>
                  </div>
                )}
              </div>

              {/* Duration Options (for hourly services) */}
              <div className="card-elevated p-4">
                <div className="flex items-center justify-between mb-4">
                  <h3 className="text-lg font-bold">Duration Options</h3>
                  <button
                    onClick={() => addArrayItem('durationOptions', {
                      hours: 1,
                      price: serviceData.price || 0,
                      isDefault: false,
                      minimumHours: 1
                    })}
                    className="text-sm text-primary flex items-center gap-1"
                  >
                    <Plus className="w-4 h-4" /> Add Duration
                  </button>
                </div>
                {/* eslint-disable-next-line @typescript-eslint/no-explicit-any */}
                {serviceData.durationOptions?.map((opt: any, idx: number) => (
                  <div key={idx} className="grid grid-cols-4 gap-2 mb-2">
                    <input
                      type="number"
                      value={opt.hours || 1}
                      onChange={(e) => updateArrayItem('durationOptions', idx, 'hours', parseFloat(e.target.value))}
                      placeholder="Hours"
                      className="p-2 rounded border border-border bg-background"
                    />
                    <input
                      type="number"
                      value={opt.price || 0}
                      onChange={(e) => updateArrayItem('durationOptions', idx, 'price', parseFloat(e.target.value))}
                      placeholder="Price"
                      className="p-2 rounded border border-border bg-background"
                    />
                    <label className="flex items-center gap-2 p-2">
                      <input
                        type="checkbox"
                        checked={opt.isDefault || false}
                        onChange={(e) => updateArrayItem('durationOptions', idx, 'isDefault', e.target.checked)}
                        className="w-4 h-4"
                      />
                      <span className="text-sm">Default</span>
                    </label>
                    <button
                      onClick={() => removeArrayItem('durationOptions', idx)}
                      className="p-2 bg-red-500/10 text-red-500 rounded hover:bg-red-500/20"
                    >
                      <Minus className="w-4 h-4" />
                    </button>
                  </div>
                ))}
              </div>

              {/* Pricing Tiers (for quantity-based services) */}
              <div className="card-elevated p-4">
                <div className="flex items-center justify-between mb-4">
                  <h3 className="text-lg font-bold">Pricing Tiers (Quantity-Based)</h3>
                  <button
                    onClick={() => addArrayItem('pricingTiers', {
                      quantityFrom: 1,
                      quantityTo: 1,
                      pricePerUnit: serviceData.price || 0,
                      totalPrice: serviceData.price || 0,
                      duration: 60
                    })}
                    className="text-sm text-primary flex items-center gap-1"
                  >
                    <Plus className="w-4 h-4" /> Add Tier
                  </button>
                </div>
                {/* eslint-disable-next-line @typescript-eslint/no-explicit-any */}
                {serviceData.pricingTiers?.map((tier: any, idx: number) => (
                  <div key={idx} className="grid grid-cols-6 gap-2 mb-2">
                    <input
                      type="number"
                      value={tier.quantityFrom || 1}
                      onChange={(e) => updateArrayItem('pricingTiers', idx, 'quantityFrom', parseInt(e.target.value))}
                      placeholder="From Qty"
                      className="p-2 rounded border border-border bg-background"
                    />
                    <input
                      type="number"
                      value={tier.quantityTo || 1}
                      onChange={(e) => updateArrayItem('pricingTiers', idx, 'quantityTo', parseInt(e.target.value))}
                      placeholder="To Qty"
                      className="p-2 rounded border border-border bg-background"
                    />
                    <input
                      type="number"
                      value={tier.pricePerUnit || 0}
                      onChange={(e) => updateArrayItem('pricingTiers', idx, 'pricePerUnit', parseFloat(e.target.value))}
                      placeholder="₹/unit"
                      className="p-2 rounded border border-border bg-background"
                    />
                    <input
                      type="number"
                      value={tier.totalPrice || 0}
                      onChange={(e) => updateArrayItem('pricingTiers', idx, 'totalPrice', parseFloat(e.target.value))}
                      placeholder="Total ₹"
                      className="p-2 rounded border border-border bg-background"
                    />
                    <input
                      type="number"
                      value={tier.duration || 60}
                      onChange={(e) => updateArrayItem('pricingTiers', idx, 'duration', parseInt(e.target.value))}
                      placeholder="Duration"
                      className="p-2 rounded border border-border bg-background"
                    />
                    <button
                      onClick={() => removeArrayItem('pricingTiers', idx)}
                      className="p-2 bg-red-500/10 text-red-500 rounded hover:bg-red-500/20"
                    >
                      <Minus className="w-4 h-4" />
                    </button>
                  </div>
                ))}
              </div>
            </div>
          )}

          {/* SUBSCRIPTION TAB */}
          {activeTab === 'subscription' && (
            <div className="space-y-6">
              <div className="card-elevated p-4">
                <div className="flex items-center justify-between mb-4">
                  <h3 className="text-lg font-bold">Subscription Options</h3>
                  <label className="flex items-center gap-2">
                    <input
                      type="checkbox"
                      checked={serviceData.subscriptionOptions?.enabled || false}
                      onChange={(e) => updateField('subscriptionOptions.enabled', e.target.checked)}
                      className="w-4 h-4"
                    />
                    <span className="text-sm">Enable Subscriptions</span>
                  </label>
                </div>

                {serviceData.subscriptionOptions?.enabled && (
                  <div className="space-y-4">
                    <div className="grid grid-cols-2 gap-4">
                      <div>
                        <label className="block text-sm font-medium mb-2">Min Contract (months)</label>
                        <input
                          type="number"
                          value={serviceData.subscriptionOptions?.minContractMonths || 1}
                          onChange={(e) => updateField('subscriptionOptions.minContractMonths', parseInt(e.target.value))}
                          className="w-full p-2 rounded border border-border bg-background"
                        />
                      </div>
                      <div>
                        <label className="block text-sm font-medium mb-2">Max Contract (months)</label>
                        <input
                          type="number"
                          value={serviceData.subscriptionOptions?.maxContractMonths || 12}
                          onChange={(e) => updateField('subscriptionOptions.maxContractMonths', parseInt(e.target.value))}
                          className="w-full p-2 rounded border border-border bg-background"
                        />
                      </div>
                    </div>

                    <div>
                      <label className="block text-sm font-medium mb-2">Discount Percentage</label>
                      <input
                        type="number"
                        value={serviceData.subscriptionOptions?.discountPercentage || 0}
                        onChange={(e) => updateField('subscriptionOptions.discountPercentage', parseFloat(e.target.value))}
                        className="w-full p-2 rounded border border-border bg-background"
                        min="0"
                        max="100"
                      />
                    </div>

                    <div className="space-y-2">
                      <label className="block text-sm font-medium">Allowed Frequencies</label>
                      {['daily', 'weekly', 'biweekly', 'custom'].map((freq) => (
                        <label key={freq} className="flex items-center gap-2">
                          <input
                            type="checkbox"
                            checked={serviceData.subscriptionOptions?.allowedFrequencies?.includes(freq) || false}
                            onChange={(e) => {
                              const current = serviceData.subscriptionOptions?.allowedFrequencies || [];
                              const updated = e.target.checked
                                ? [...current, freq]
                                : current.filter((f: string) => f !== freq);
                              updateField('subscriptionOptions.allowedFrequencies', updated);
                            }}
                            className="w-4 h-4"
                          />
                          <span className="text-sm capitalize">{freq}</span>
                        </label>
                      ))}
                    </div>

                    <label className="flex items-center gap-2">
                      <input
                        type="checkbox"
                        checked={serviceData.subscriptionOptions?.requiresSameWorker || false}
                        onChange={(e) => updateField('subscriptionOptions.requiresSameWorker', e.target.checked)}
                        className="w-4 h-4"
                      />
                      <span className="text-sm">Requires Same Worker</span>
                    </label>

                    <label className="flex items-center gap-2">
                      <input
                        type="checkbox"
                        checked={serviceData.subscriptionOptions?.autoRenewal !== false}
                        onChange={(e) => updateField('subscriptionOptions.autoRenewal', e.target.checked)}
                        className="w-4 h-4"
                      />
                      <span className="text-sm">Enable Auto-Renewal</span>
                    </label>
                  </div>
                )}
              </div>
            </div>
          )}

          {/* ADD-ONS TAB */}
          {activeTab === 'addons' && (
            <div className="space-y-6">
              <div className="card-elevated p-4">
                <div className="flex items-center justify-between mb-4">
                  <h3 className="text-lg font-bold">Add-ons & Extras</h3>
                  <button
                    onClick={() => addArrayItem('addons', {
                      id: `addon-${Date.now()}`,
                      name: '',
                      description: '',
                      price: 0,
                      duration: 0,
                      optional: true,
                      category: 'additional_service',
                      icon: '➕',
                      isActive: true
                    })}
                    className="text-sm text-primary flex items-center gap-1"
                  >
                    <Plus className="w-4 h-4" /> Add Item
                  </button>
                </div>
                {/* eslint-disable-next-line @typescript-eslint/no-explicit-any */}
                {serviceData.addons?.map((addon: any, idx: number) => (
                  <div key={idx} className="p-4 border border-border rounded-lg mb-3">
                    <div className="grid grid-cols-2 gap-3 mb-3">
                      <input
                        type="text"
                        value={addon.name || ''}
                        onChange={(e) => updateArrayItem('addons', idx, 'name', e.target.value)}
                        placeholder="Add-on Name"
                        className="p-2 rounded border border-border bg-background"
                      />
                      <input
                        type="text"
                        value={addon.icon || ''}
                        onChange={(e) => updateArrayItem('addons', idx, 'icon', e.target.value)}
                        placeholder="Icon (emoji)"
                        className="p-2 rounded border border-border bg-background"
                      />
                    </div>
                    <textarea
                      value={addon.description || ''}
                      onChange={(e) => updateArrayItem('addons', idx, 'description', e.target.value)}
                      placeholder="Description"
                      rows={2}
                      className="w-full p-2 rounded border border-border bg-background mb-3"
                    />
                    <div className="grid grid-cols-3 gap-3 mb-3">
                      <input
                        type="number"
                        value={addon.price || 0}
                        onChange={(e) => updateArrayItem('addons', idx, 'price', parseFloat(e.target.value))}
                        placeholder="Price (₹)"
                        className="p-2 rounded border border-border bg-background"
                      />
                      <input
                        type="number"
                        value={addon.duration || 0}
                        onChange={(e) => updateArrayItem('addons', idx, 'duration', parseInt(e.target.value))}
                        placeholder="Extra time (min)"
                        className="p-2 rounded border border-border bg-background"
                      />
                      <select
                        value={addon.category || 'additional_service'}
                        onChange={(e) => updateArrayItem('addons', idx, 'category', e.target.value)}
                        className="p-2 rounded border border-border bg-background"
                      >
                        <option value="additional_service">Additional Service</option>
                        <option value="equipment">Equipment</option>
                        <option value="priority">Priority</option>
                        <option value="other">Other</option>
                      </select>
                    </div>
                    <div className="flex items-center justify-between">
                      <label className="flex items-center gap-2">
                        <input
                          type="checkbox"
                          checked={addon.optional !== false}
                          onChange={(e) => updateArrayItem('addons', idx, 'optional', e.target.checked)}
                          className="w-4 h-4"
                        />
                        <span className="text-sm">Optional</span>
                      </label>
                      <button
                        onClick={() => removeArrayItem('addons', idx)}
                        className="px-3 py-1 bg-red-500/10 text-red-500 rounded hover:bg-red-500/20 text-sm"
                      >
                        Remove
                      </button>
                    </div>
                  </div>
                ))}
              </div>

              {/* Equipment Requirements */}
              <div className="card-elevated p-4">
                <h3 className="text-lg font-bold mb-4">Equipment Requirements</h3>
                
                <div>
                  <label className="block text-sm font-medium mb-2">Equipment Provided By</label>
                  <select
                    value={serviceData.equipmentRequired?.providedBy || 'worker'}
                    onChange={(e) => updateField('equipmentRequired.providedBy', e.target.value)}
                    className="w-full p-2 rounded border border-border bg-background mb-3"
                  >
                    <option value="worker">Worker Brings Equipment</option>
                    <option value="customer">Customer Provides</option>
                    <option value="both">Both</option>
                    <option value="optional">Optional</option>
                  </select>
                </div>

                <div>
                  <label className="block text-sm font-medium mb-2">Equipment Notes</label>
                  <textarea
                    value={serviceData.equipmentRequired?.notes || ''}
                    onChange={(e) => updateField('equipmentRequired.notes', e.target.value)}
                    rows={2}
                    placeholder="Any special equipment notes..."
                    className="w-full p-2 rounded border border-border bg-background"
                  />
                </div>
              </div>
            </div>
          )}

          {/* ADVANCED TAB */}
          {activeTab === 'advanced' && (
            <div className="space-y-6">
              {/* Worker Preferences */}
              <div className="card-elevated p-4">
                <h3 className="text-lg font-bold mb-4">Worker Requirements</h3>
                
                <div className="grid grid-cols-2 gap-4">
                  <div>
                    <label className="block text-sm font-medium mb-2">Min Rating</label>
                    <input
                      type="number"
                      value={serviceData.workerPreferences?.ratingMinimum || 0}
                      onChange={(e) => updateField('workerPreferences.ratingMinimum', parseFloat(e.target.value))}
                      min="0"
                      max="5"
                      step="0.1"
                      className="w-full p-2 rounded border border-border bg-background"
                    />
                  </div>
                  <div>
                    <label className="block text-sm font-medium mb-2">Min Experience (months)</label>
                    <input
                      type="number"
                      value={serviceData.workerPreferences?.experienceRequired || 0}
                      onChange={(e) => updateField('workerPreferences.experienceRequired', parseInt(e.target.value))}
                      className="w-full p-2 rounded border border-border bg-background"
                    />
                  </div>
                </div>

                <div className="grid grid-cols-2 gap-4 mt-3">
                  <label className="flex items-center gap-2">
                    <input
                      type="checkbox"
                      checked={serviceData.workerPreferences?.genderPreference !== false}
                      onChange={(e) => updateField('workerPreferences.genderPreference', e.target.checked)}
                      className="w-4 h-4"
                    />
                    <span className="text-sm">Allow Gender Preference</span>
                  </label>
                  <label className="flex items-center gap-2">
                    <input
                      type="checkbox"
                      checked={serviceData.workerPreferences?.languagePreference !== false}
                      onChange={(e) => updateField('workerPreferences.languagePreference', e.target.checked)}
                      className="w-4 h-4"
                    />
                    <span className="text-sm">Allow Language Preference</span>
                  </label>
                </div>
              </div>

              {/* Cancellation Policy */}
              <div className="card-elevated p-4">
                <h3 className="text-lg font-bold mb-4">Cancellation Policy</h3>
                
                <label className="flex items-center gap-2 mb-4">
                  <input
                    type="checkbox"
                    checked={serviceData.cancellationPolicy?.allowCancellation !== false}
                    onChange={(e) => updateField('cancellationPolicy.allowCancellation', e.target.checked)}
                    className="w-4 h-4"
                  />
                  <span className="text-sm">Allow Cancellation</span>
                </label>

                {serviceData.cancellationPolicy?.allowCancellation !== false && (
                  <div className="grid grid-cols-2 gap-4">
                    <div>
                      <label className="block text-sm font-medium mb-2">Free Cancel Hours Before</label>
                      <input
                        type="number"
                        value={serviceData.cancellationPolicy?.freeCancelHoursBeforeService || 24}
                        onChange={(e) => updateField('cancellationPolicy.freeCancelHoursBeforeService', parseInt(e.target.value))}
                        className="w-full p-2 rounded border border-border bg-background"
                      />
                    </div>
                    <div>
                      <label className="block text-sm font-medium mb-2">Cancellation Charge (%)</label>
                      <input
                        type="number"
                        value={serviceData.cancellationPolicy?.cancellationChargePercentage || 0}
                        onChange={(e) => updateField('cancellationPolicy.cancellationChargePercentage', parseFloat(e.target.value))}
                        min="0"
                        max="100"
                        className="w-full p-2 rounded border border-border bg-background"
                      />
                    </div>
                  </div>
                )}
              </div>

              {/* Time Slot Restrictions */}
              <div className="card-elevated p-4">
                <h3 className="text-lg font-bold mb-4">Booking Window</h3>
                
                <div className="grid grid-cols-2 gap-4">
                  <div>
                    <label className="block text-sm font-medium mb-2">Min Hours Advance</label>
                    <input
                      type="number"
                      value={serviceData.timeSlotRestrictions?.bookingWindow?.minHoursAdvance || 2}
                      onChange={(e) => updateField('timeSlotRestrictions.bookingWindow.minHoursAdvance', parseInt(e.target.value))}
                      className="w-full p-2 rounded border border-border bg-background"
                    />
                  </div>
                  <div>
                    <label className="block text-sm font-medium mb-2">Max Days Advance</label>
                    <input
                      type="number"
                      value={serviceData.timeSlotRestrictions?.bookingWindow?.maxDaysAdvance || 30}
                      onChange={(e) => updateField('timeSlotRestrictions.bookingWindow.maxDaysAdvance', parseInt(e.target.value))}
                      className="w-full p-2 rounded border border-border bg-background"
                    />
                  </div>
                </div>
              </div>
            </div>
          )}
        </div>

        {/* Footer */}
        <div className="p-6 border-t border-border flex items-center justify-between bg-muted/30">
          <p className="text-sm text-muted-foreground">
            Make sure to save your changes before closing
          </p>
          <div className="flex gap-3">
            <button
              onClick={onCancel}
              className="px-6 py-2 rounded-lg border border-border hover:bg-muted transition-colors"
            >
              Cancel
            </button>
            <button
              onClick={onSave}
              className="px-6 py-2 rounded-lg bg-primary text-primary-foreground hover:bg-primary/90 transition-colors flex items-center gap-2"
            >
              <Save className="w-4 h-4" />
              Save Parameters
            </button>
          </div>
        </div>
      </div>
    </div>
  );
};

export default ServiceParametersEditor;
