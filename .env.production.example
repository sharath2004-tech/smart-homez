# Production Environment Variables
# Set these environment variables in your deployment platform (Vercel, Netlify, etc.)

# Backend API URL - REQUIRED
# Replace with your actual backend API URL
VITE_API_URL=https://your-backend-api.com/api

# App Configuration
VITE_APP_NAME=Pure App Weave
VITE_APP_VERSION=1.0.0

# Feature Flags
VITE_ENABLE_ANALYTICS=true
VITE_ENABLE_DEBUG=false

# Google OAuth (Customer Login) - REQUIRED
# Get Client ID from: https://console.cloud.google.com
# Must match the backend GOOGLE_CLIENT_ID
# Make sure to add your production domain to authorized origins
VITE_GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com
