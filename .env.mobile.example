# Mobile Environment Variables
# Copy this file to .env.mobile for local device/emulator testing
# Run: npm run build:mobile  (uses this file via --mode mobile)

# ⚠️  Use your machine's LAN IP — NOT localhost (emulators can't reach localhost)
# Find your IP:  Windows → ipconfig | Linux/Mac → ifconfig
# Production backend (recommended)
VITE_API_URL=https://smart-homez.onrender.com/api

# Local dev via USB (requires: adb reverse tcp:5000 tcp:5000)
# VITE_API_URL=http://localhost:5000/api

# App Configuration
VITE_APP_NAME=Healthy Homez
VITE_APP_VERSION=1.0.0

# Feature Flags
VITE_ENABLE_ANALYTICS=false
VITE_ENABLE_DEBUG=true

# Google OAuth
VITE_GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com

# MSG91 OTP Widget
VITE_MSG91_WIDGET_ID=your_msg91_widget_id_here
VITE_MSG91_TOKEN_AUTH=your_msg91_token_auth_here
