# Production Frontend Environment Variables
# Update VITE_API_URL with your production backend URL

# Backend API URL - Connected to Render backend
VITE_API_URL=https://smart-homez.onrender.com/api

# App Configuration
VITE_APP_NAME=Healthy Homez
VITE_APP_VERSION=1.0.0

# Feature Flags
VITE_ENABLE_ANALYTICS=true
VITE_ENABLE_DEBUG=false
