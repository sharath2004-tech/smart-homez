{
  "name": "pure-app-weave-backend",
  "version": "1.0.0",
  "description": "Backend server for Pure App Weave",
  "main": "server.js",
  "type": "module",
  "scripts": {
    "start": "node server.js",
    "dev": "nodemon server.js",
    "prod": "NODE_ENV=production node server.js",
    "seed:admins": "node seedAdmins.js",
    "seed:services": "node seedServices.js",
    "clear:db": "node clearDatabase.js",
    "check:accounts": "node checkAccounts.js",
    "activate": "node activateAccount.js",
    "deactivate": "node deactivateWorker.js",
    "cleanup:db": "node utils/cleanupDatabase.js"
  },
  "keywords": [
    "express",
    "mongodb",
    "health",
    "services"
  ],
  "author": "Pure App Weave Team",
  "license": "ISC",
  "dependencies": {
    "@sendgrid/mail": "^8.1.6",
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.3.1",
    "express": "^4.18.2",
    "express-rate-limit": "^7.5.0",
    "express-validator": "^7.0.1",
    "google-auth-library": "^9.6.0",
    "jsonwebtoken": "^9.0.2",
    "mongoose": "^8.0.0",
    "multer": "^2.1.0",
    "nodemailer": "^8.0.2",
    "twilio": "^5.12.2"
  },
  "devDependencies": {
    "nodemon": "^3.0.1"
  }
}
