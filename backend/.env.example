# MongoDB Atlas Connection String
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/smart-homez?retryWrites=true&w=majority&appName=Cluster0

# Server Configuration
PORT=5000
NODE_ENV=development

# JWT Secret
JWT_SECRET=your_jwt_secret_key_here_change_in_production

# Allowed Origins (for CORS) - comma-separated list
# Supports wildcards: https://smart-homez-*.vercel.app
# For production, add your frontend domain(s)
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:8080,http://localhost:8081,http://localhost:8082
