# Frontend Environment Variables
# Copy this file to .env.local for local development
# or .env.production for production build

# Backend API URL
VITE_API_URL=http://localhost:5000/api

# App Configuration
VITE_APP_NAME=Pure App Weave
VITE_APP_VERSION=1.0.0

# Feature Flags (optional)
VITE_ENABLE_ANALYTICS=false
VITE_ENABLE_DEBUG=true

# Google OAuth (Customer Login)
# Get Client ID from: https://console.cloud.google.com
# Must match the Client ID configured in backend/.env
VITE_GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com

# ── Google Cloud Translation API ──────────────────────────────────────────────
# The API key lives in backend/.env as GOOGLE_TRANSLATE_API_KEY (never exposed
# to the browser). The frontend calls the backend proxy at /api/translate.
# No frontend env var is needed — just set the key in backend/.env.

# MSG91 OTP Widget (No DLT required)
# Get from MSG91 Dashboard → OTP Widget → Widget Settings
# widgetId is safe to expose in the browser
VITE_MSG91_WIDGET_ID=your_msg91_widget_id_here
# tokenAuth is the per-widget auth token (safe for browser, not your main API key)
VITE_MSG91_TOKEN_AUTH=your_msg91_token_auth_here

# Firebase Configuration (REMOVED — OTP now uses Twilio, see below)

# ── Backend environment variables (add to backend/.env) ──────────────────────

# Twilio SMS OTP — https://console.twilio.com
# 1. Create a Verify Service in Twilio Console and copy the SID
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=your_twilio_auth_token
TWILIO_VERIFY_SID=VAxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
